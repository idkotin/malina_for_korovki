[Unit]
Description=Host Monitor Telemetry Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/host-monitor
ExecStart=/usr/bin/python3 -m host_monitor.main --config /opt/host-monitor/config.yaml
Restart=always
RestartSec=2

# Logs go to journald + our rotating file.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

