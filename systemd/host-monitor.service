[Unit]
Description=Host Monitor Telemetry Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/host-monitor
ExecStart=/opt/host-monitor/.venv/bin/host-monitor --config /opt/host-monitor/config.yaml
Restart=always
RestartSec=2

# Logs go to journald + our rotating file.
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target

